{
  "name": "my-finance",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "ng": "ng",
    "start": "node --use-system-ca scripts/dev.cjs",
    "start:client": "ng serve",
    "start:api": "node --use-system-ca scripts/run-api.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "start:prod": "node --use-system-ca scripts/run-api.cjs",
    "screenshots": "node scripts/render-design-screenshots.cjs",
    "test:api": "node --test server/tests/api.test.cjs server/tests/exchange-rates.test.cjs server/tests/finance-engine.test.cjs server/tests/merchant-category-rules.test.cjs server/tests/security-config.test.cjs",
    "test:mysql": "node --test server/tests/mysql.integration.test.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "chart.js": "^4.6.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.9.1",
    "mysql2": "^3.24.6",
    "pdfjs-dist": "^6.5.438",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.57.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.12.0",
    "@types/supertest": "^6.0.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "supertest": "^7.0.0",
    "typescript": "6.0.3"
  }
}
