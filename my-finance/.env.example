# Google OAuth Web Client ID. Add http://localhost:4200 as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# MySQL server connection. Keep real values only in this ignored local .env file.
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=your-database-name
MYSQL_USER=your-app-user
MYSQL_PASSWORD=your-app-password

# Optional in development. TLS is mandatory in production.
# MYSQL_SSL=true
# MYSQL_SSL_CA=C:/path/to/provider-ca.pem
# APP_ORIGIN=https://finance.example.com
